# Memdoor environment example.
# Copy to .env and fill in values that apply to your deploy.
#
# Every model call runs on your own provider key; there is no local model.
# One of these is enough (or run `memdoor connect`):
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...

# Email provider for invites + notifications: resend | smtp | local | console
EMAIL_PROVIDER=console
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@memdoor.ai
EMAIL_FROM_NAME=Memdoor

# Email address to receive demo / contact-form notifications.
DEMO_NOTIFY_EMAIL=your-email@example.com

# Public base URL — used in email links + invite tokens.
# BASE_URL=https://memdoor.ai

# Local service endpoints. These are independent of MEMDOOR_REMOTE_URL, which
# configures only the remote-control relay.
MEMDOOR_TELEMETRY_URL=http://localhost:18789/api/telemetry
MEMDOOR_ACCOUNT_URL=http://localhost:18790
MEMDOOR_REMOTE_URL=http://localhost:18789

# Install and upgrade from GitHub Releases by default.
# MEMDOOR_GITHUB_REPOSITORY=Erro7/memdoor
# MEMDOOR_GITHUB_RELEASE=latest

# To use a self-hosted distribution server instead:
# MEMDOOR_INSTALL_SOURCE=local
# MEMDOOR_DISTRIBUTION_URL=http://localhost:18789
